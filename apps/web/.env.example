# apps/web environment. Copy to apps/web/.env for local development.
# Where the web server proxies /api/* and /.well-known/oauth-* (read on every request, so one build can point at any API).
API_ORIGIN=http://localhost:5000
VITE_APP_NAME=Arrakit
VITE_SITE_URL=https://example.com
# Optional Plausible-compatible analytics (e.g. https://plausible.io/js/script.js). Both or none.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
