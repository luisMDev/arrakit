# apps/api environment. Copy to apps/api/.env for local development.
# Everything is optional in dev: without DATABASE_URL the API uses PGlite, without
# RESEND_API_KEY mail goes to the console/outbox, with STRIPE_FAKE=1 Stripe is faked.

NODE_ENV=development
PORT=3000

# Database: real Postgres when set; otherwise PGlite stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
# PGLITE_RESET=1 deletes PGLITE_DIR at boot (throwaway e2e databases).
PGLITE_RESET=

# Better Auth. BETTER_AUTH_URL is the WEB origin (web and API are one site through the proxy);
# it is also the only trusted Origin for sign-in and state-changing calls.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4200
WEB_URL=http://localhost:4200

# Social sign-in (optional; the buttons hide when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mail (Resend). Without RESEND_API_KEY mail is logged and kept in the dev outbox.
RESEND_API_KEY=
MAIL_FROM="Arrakit <hello@example.com>"

# Stripe. STRIPE_FAKE=1 uses the in-memory fake gateway (dev and e2e).
STRIPE_FAKE=1
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# File storage (S3-compatible: R2, MinIO, S3). Without it files go to STORAGE_DIR.
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_DIR=.data/storage
