# apps/api environment. Copy to apps/api/.env for local development: `pnpm dev`, `pnpm start`
# and the scripts load it with `node --env-file-if-exists=.env`; in production set these in the
# process env. Everything is optional in dev: without DATABASE_URL the API uses PGlite, without
# RESEND_API_KEY mail goes to Mailpit (MAILPIT_URL) or the console, with STRIPE_FAKE=1 Stripe is
# faked.
#
# With NODE_ENV=production the API refuses to start unless these are set: GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET, DATABASE_URL, every R2_* below (except R2_REGION) and RESEND_API_KEY.
# STRIPE_FAKE=1 is refused in production.

NODE_ENV=development
PORT=5000

# Database: Postgres when set (the data, the migrations applied on boot, and pg-boss's `pgboss`
# schema); otherwise PGlite stored in PGLITE_DIR. Required in production.
# DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_URL=
PGLITE_DIR=.data/pglite
# PGLITE_RESET=1 deletes PGLITE_DIR at boot (throwaway e2e databases).
PGLITE_RESET=

# Better Auth (/api/auth). The secret signs the session cookie: at least 32 random characters
# (`openssl rand -base64 32`), never committed; the API refuses to start with a shorter one.
# Replace the placeholder below before any shared or production use.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# BETTER_AUTH_URL is the public WEB origin the browser reaches /api/auth at (web and API are one
# site through the web proxy, so the cookie is first-party); magic links point here. It is also
# the only trusted Origin for sign-in and state-changing calls.
BETTER_AUTH_URL=http://localhost:5200
# Optional. The web app's origin when it is not BETTER_AUTH_URL's; a sign-in may only redirect
# to these two.
WEB_URL=http://localhost:5200

# "Continue with Google": an OAuth client (type "Web application") in Google Cloud Console.
# Its authorized redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google. Set both or
# neither: without them a local run signs in by magic link only (the button hides); with
# NODE_ENV=production the API refuses to start without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with Microsoft": an app registration in Microsoft Entra ID, for accounts in any
# organization and personal accounts (tenant `common`), with the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/microsoft. Set both or neither: without them the button
# hides and the API still starts. The app must emit the optional ID token claims `email` and
# `xms_edov`: a Microsoft sign-in is accepted only when the token carries
# `email_verified: true` or `xms_edov: true`.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# The MCP server is at <BETTER_AUTH_URL>/api/mcp. A client such as Claude registers itself and
# signs each person in through /api/auth/oauth2/*, discovered at
# <BETTER_AUTH_URL>/.well-known/oauth-protected-resource/api/mcp.

# Email through Resend. With NODE_ENV=production the API refuses to start without a key.
RESEND_API_KEY=
# Without RESEND_API_KEY, mail goes to Mailpit at this origin (`docker compose up -d mailpit`;
# read it at http://localhost:5025). Without either the API only logs each email, sign-in links
# included.
MAILPIT_URL=http://localhost:5025
# Optional. The sender of every email.
MAIL_FROM="Arrakit <hello@example.com>"

# Stripe, for paying for a plan and for credit top-ups. Test mode locally (`sk_test_...`,
# `pk_test_...`). The webhook secret is the endpoint's signing secret (`whsec_...`); locally
# `stripe listen --forward-to localhost:5000/api/webhooks/stripe` prints one. Without all three
# keys the API still starts, Checkout answers 503 and the webhook 401. Prices and the credits
# product are made once per account with `pnpm --filter @arrakit/api stripe:prices`.
# STRIPE_FAKE=1 uses the in-memory fake gateway instead (dev and e2e only).
STRIPE_FAKE=1
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# File storage (S3-compatible: Cloudflare R2, AWS S3, MinIO). All four of R2_ENDPOINT, R2_BUCKET,
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY or none; required in production. Without them files
# stay in memory. R2_REGION is optional (R2's region is `auto`, the default).
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Logs: Pino, one JSON object per line (LOG_FORMAT=json) or pino-pretty (LOG_FORMAT=pretty,
# needs the dev dependencies). Defaults: pretty in development, json otherwise; level info
# (silent in tests). Levels: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=
LOG_FORMAT=

# Sentry: unexpected errors (anything answered 500) are sent here. Without a DSN they are only
# logged. SENTRY_ENVIRONMENT defaults to NODE_ENV; SENTRY_RELEASE is e.g. the commit SHA.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
