---
import LogoMark from '../components/LogoMark.astro'
import Base from '../layouts/Base.astro'
import { APP_NAME } from '../lib/config'
---

<Base
  title={`Page not found · ${APP_NAME}`}
  bodyClass="flex min-h-svh flex-col items-center justify-center gap-7 bg-white px-4 py-5 text-center text-neutral-900"
>
  <meta slot="head" name="robots" content="noindex" />
  <LogoMark />
  <h1 class="text-2xl font-light sm:text-3xl">This page does not exist.</h1>
  <a class="underline underline-offset-4" href="/">Back home</a>
</Base>
