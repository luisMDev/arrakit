{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "PGLITE_DIR",
    "PGLITE_RESET",
    "STRIPE_*",
    "BETTER_AUTH_*",
    "RESEND_API_KEY",
    "MAIL_FROM",
    "MAILPIT_URL",
    "LOG_LEVEL",
    "LOG_FORMAT",
    "SENTRY_*",
    "R2_*",
    "S3_*",
    "GOOGLE_*",
    "MICROSOFT_*",
    "WEB_URL",
    "API_ORIGIN",
    "PORT",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.test.*", "!**/*.spec.*", "!e2e/**"],
      "outputs": ["dist/**", ".output/**", "!.output/cache/**"],
      "env": ["VITE_*", "PUBLIC_*"]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["E2E_WEB_PORT", "E2E_API_PORT", "E2E_MAILPIT_PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#typecheck:scripts": {
      "inputs": ["scripts/**", "packages/tsconfig/**"]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**"]
    },
    "//#mailpit": {
      "cache": false,
      "persistent": true
    }
  }
}
