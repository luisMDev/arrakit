{
  "name": "arrakit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Arrakit: a SaaS base on pnpm + Turborepo, React + TanStack Start, Hono + oRPC, Drizzle and Better Auth.",
  "scripts": {
    "dev": "pnpm supabase:start && turbo run dev //#rustfs",
    "supabase:start": "node scripts/supabase-keys.ts && supabase start && supabase migration up",
    "supabase:stop": "supabase stop",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "rustfs": "scripts/rustfs.sh --address 127.0.0.1:5030 --console-address 127.0.0.1:5031 .data/rustfs",
    "init:project": "node scripts/init.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck //#typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts",
    "lint": "turbo run lint",
    "test": "turbo run test //#test:scripts",
    "test:scripts": "vitest run --dir scripts",
    "test:e2e": "pnpm supabase:start && turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
